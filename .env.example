# OpenAQ — PRIMARY air quality source (optional key, rate-limited without)
OPENAQ_API_KEY=
# WAQI (waqi.info) — SECONDARY fallback + independent forecast (free token)
WAQI_API_KEY=
OPENWEATHER_API_KEY=
NASA_FIRMS_API_KEY=
GEMINI_API_KEY=
# data.gov.in — PRIMARY CPCB ground truth (free key at data.gov.in → “CPCB AQI API”).
# Without it the chain falls through to WAQI → OpenAQ → demo.
DATAGOV_API_KEY=
# TFT third member needs ~450MB+ RAM alone: auto-skipped on small hosts
# (e.g. Render free 512MB serves tree-only). 1 = force on, 0 = force off.
TFT_ENABLED=auto
# Shared secret for POST /api/v1/forecasts/overlay (daily TFT bundle
# from CI/local runner). Unset = endpoint disabled. Set the SAME value
# as Render env INGEST_KEY + CI secret INGEST_KEY.
INGEST_KEY=
MAPTILER_KEY=
# CARTO raster basemap key (optional, free at carto.com/basemaps/apikey).
# Without it the map falls back to plain OpenStreetMap tiles.
CARTO_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Data pipeline
DATA_REFRESH_INTERVAL=300
DATABASE_PATH=data/aqi_data.db
DEMO_MODE=false

# Set true to let Gemini optionally rephrase policy advisories.
# Forecasting NEVER uses an LLM — only the template engine (off by default).
LLM_ENHANCED=false
